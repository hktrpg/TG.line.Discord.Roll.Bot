FROM node:24.22.1-alpine

# Install browser dependencies for WhatsApp and fonts shared by image features.
RUN apk update && apk upgrade --no-cache && apk add --no-cache \
    tzdata \
    git \
    curl \
    chromium \
    nss \
    freetype \
    harfbuzz \
    ca-certificates \
    ttf-freefont \
    fontconfig \
    font-noto-cjk \
    && rm -rf /var/cache/apk/*

ENV TZ=Asia/Taipei
ENV LANG=zh_TW.UTF-8
ENV LC_ALL=zh_TW.UTF-8

RUN ln -snf /usr/share/zoneinfo/$TZ /etc/localtime \
    && echo $TZ > /etc/timezone \
    && ln -s /usr/bin/chromium /usr/bin/chromium-browser || true \
    && ln -s /usr/bin/chromium /usr/bin/google-chrome || true \
    && fc-cache -fv

WORKDIR /app

COPY package.json yarn.lock ./
COPY modules/chat/social-video-tools.js ./modules/chat/social-video-tools.js
COPY scripts/setup-social-video.js ./scripts/setup-social-video.js
ENV PUPPETEER_SKIP_DOWNLOAD=true
ENV HKTRPG_SOCIAL_VIDEO_TOOLS_DIR=/opt/hktrpg-media-tools
RUN corepack enable \
    && yarn install --frozen-lockfile --non-interactive

COPY . .

#RUN mkdir -p /app/log /app/export /app/temp /app/.wwebjs_auth \
#    && chown -R node:node /app/log /app/export /app/temp /app/.wwebjs_auth

USER node
RUN node scripts/setup-social-video.js --check

CMD ["node", "index.js"]
