# Roll Worker backend (optional). When set, gateways POST parseInput to this URL.
# Manual side worker: yarn start:roll-worker (:20614). Replace Primary: yarn start:roll-worker:primary (:20612).
# ROLL_WORKER_URL=http://127.0.0.1:20612
# Optional label on Worker CONNECTED logs (default: auto Discord+Telegram+Line+…).
# ROLL_GATEWAY_NAME=Discord-prod
# Shared secret (same value on worker + all gateways).
# If unset, Worker/Gateway auto-generate and append to .env on first start.
# ROLL_WORKER_TOKEN=change-me
# ROLL_WORKER_TIMEOUT_MS=120000
# Primary + optional Standby HTTP dice (same binary: yarn start:roll-worker)
# Default: Gateway auto-discovers/spawns Primary only (:20612).
# Standby (:20613): set ROLL_STANDBY_URL and/or ROLL_STANDBY_SPAWN=true
# With SPAWN=true, Gateway discovers an already-running manual Standby on :20613 (no double-bind).
# Opt-out Primary auto-frame (Embedded only unless ROLL_WORKER_URL set): ROLL_WORKER_SPAWN=false
# Enable Standby auto-spawn: ROLL_STANDBY_SPAWN=true
# Pipe supervised child stdout to Gateway (off by default; causes IDE debugger duplicates):
# ROLL_WORKER_CHILD_LOG=true
# Verbose discover/reuse logs: ROLL_WORKER_DEBUG=true
# ROLL_WORKER_URL=http://127.0.0.1:20612
# ROLL_STANDBY_URL=http://127.0.0.1:20613
# ROLL_STANDBY_SPAWN=true
# ROLL_WORKER_PORT=20612
# Manual yarn start:roll-worker defaults to :20614 (avoids auto-Primary :20612 / Standby :20613).
# yarn start:roll-worker:primary → :20612 | yarn start:roll-worker:standby → :20613
# ROLL_STANDBY_PORT=20613
# ROLL_WORKER_DRAIN_MS=1500
# ROLL_STANDBY_RELOAD_WAIT_MS=15000
# Wait after .root restart primary for /health.
# ROLL_WORKER_RELOAD_WAIT_MS=15000
# ROLL_WORKER_HEALTH_PROBE_MS=5000
# Admin: .root restart / stop primary|standby (not Gateway platforms by default).
# POST /v1/admin/reload (loopback) = self-restart; /shutdown = exit for SPAWN/PM2.
# Note: ROLL_STANDBY_URL equal to ROLL_WORKER_URL is ignored (useless fallback).
# Ops version (.admin state / .root mem / Primary /health): branch · YYYY-MM-DD · sha
# Inject on servers without .git (Docker/Heroku). Optional locally — falls back to git.
# GITHUB_SHA=
# GIT_BRANCH=          # or GITHUB_REF_NAME — e.g. Distributed- when testing a non-master branch on prod
# BUILD_TIME=          # ISO8601, e.g. 2026-07-30T08:00:00Z
# Gateway: REMOTE_ONLY = never Embedded / Standby (busy or defer).
# Needs Primary up; needsLocal and errors return system_busy (or defer queue below).
# ROLL_WORKER_REMOTE_ONLY=true
# When REMOTE_ONLY: silently queue busy commands and reply later (in-memory; lost on restart).
# Opt-out: ROLL_WORKER_DEFER_BUSY=false
# ROLL_WORKER_DEFER_MAX=10000
# ROLL_WORKER_DEFER_PER_USER=20
# ROLL_WORKER_DEFER_TTL_MS=600000
# Primary/Standby bind (default loopback). Prefer 127.0.0.1 / private network only.
# ROLL_WORKER_HOST=127.0.0.1
# Max JSON body for /v1/parse (Discord exportHistoryMeta needs headroom).
# ROLL_WORKER_JSON_LIMIT=32mb
# Authenticated /v1/* rate limit per client IP (mitigates signed large-body DoS).
# ROLL_WORKER_RATE_LIMIT_POINTS=300
# ROLL_WORKER_RATE_LIMIT_DURATION=60
# ROLL_WORKER_RATE_LIMIT_DISABLED=true
# Optional Discord module denylist (comma-separated module ids forced Embedded on Discord).
# ROLL_WORKER_DISCORD_DENYLIST=
# Shared volume root when Primary/Gateway cwd differs (token images, export files).
# In Docker multi-container setups, mount the SAME /app/temp and /app/export on
# Primary + Gateways, and set the same root (usually /app):
# ROLL_ARTIFACT_ROOT=/app
# Only for local Jest/proof experiments — skips auto-generate and runs auth-off on loopback:
# ROLL_WORKER_ALLOW_NO_TOKEN=true
# Gateway HMAC (_gatewayAuth) is required whenever ROLL_WORKER_TOKEN is set.

WWW_WS_HOST=127.0.0.1
WWW_WS_PORT=53589
WWW_WS_ALLOW_NON_LOCAL=false
# Shared secret for www ↔ Discord/WhatsApp BROADCAST relay. Falls back to ROLL_WORKER_TOKEN if unset.
# Required when WWW_WS_ALLOW_NON_LOCAL=true (relay will not start without a token).
#WWW_WS_TOKEN=

