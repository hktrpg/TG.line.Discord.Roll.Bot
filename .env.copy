ALERT=false
DEBUG=
# DEBUG_LOG: When true, enables *very verbose* cluster lifecycle tracing (and Cluster Debug logs).
# This includes:
#   - full runtime metadata + call stacks for respawnAll, child_process.kill
#   - detailed event loop lag summaries (maxLagMsInWindow, traceId, full stack)
#   - [Cluster Debug] messages from discord-hybrid-sharding (what was previously under DISCORD_HEARTBEAT_DEBUG)
# Keep off for normal operation to reduce log noise. Only real problems (e.g. via HEARTBEAT_MISSING_LOG) still surface.
# Separate from the general DEBUG flag.
DEBUG_LOG=
# (DISCORD_HEARTBEAT_DEBUG is now integrated into DEBUG_LOG above for unified control)

