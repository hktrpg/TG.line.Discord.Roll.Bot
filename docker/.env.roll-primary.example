# Copy to docker/.env.roll-primary (or /data/bots/roll-primary.env in bind-mount layouts).
# Must share ROLL_WORKER_TOKEN with every Gateway.

mongoURL=mongodb://hktrpgadmin:change-this-password@mongodb:27017/hktrpgRollBot?authSource=admin

ROLL_WORKER_MODE=true
ROLL_WORKER_HOST=0.0.0.0
ROLL_WORKER_PORT=3950
ROLL_WORKER_SPAWN=false
ROLL_STANDBY_SPAWN=false
ROLL_WORKER_TOKEN=change-me-shared-secret
# Same root as Gateways; mount shared /app/temp + /app/export on all services
ROLL_ARTIFACT_ROOT=/app

# Optional admin / ops
# MASTER=
# ADMIN_SECRET=

# Copy OPENAI_* / AI_MODEL_* from a Gateway .env if you use .ai / .ait on the Worker.
# OPENAI_SWITCH=1
# OPENAI_SECRET_1=
# AI_MODEL_LOW_NAME_1=
